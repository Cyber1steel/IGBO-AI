# Copy to .env and fill in for local development. Never commit .env.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://igboai:igboai@localhost:5432/igboai

# "mock" (default) | "general" | "natlas"
AI_PROVIDER=mock

# Only needed if AI_PROVIDER=general. A real, capable LLM used as a
# practical stand-in for N-ATLaS (see backend/README.md "Using a real AI
# provider" for why Anthropic specifically, and how to swap vendors).
# Get a key at https://console.anthropic.com/ -- this costs money per use.
GENERAL_LLM_API_KEY=
GENERAL_LLM_MODEL=claude-haiku-4-5-20251001
GENERAL_LLM_BASE_URL=https://api.anthropic.com

# Only needed if AI_PROVIDER=natlas. Must be a self-hosted OpenAI-compatible
# chat-completions endpoint (e.g. vLLM's OpenAI-compatible server running
# N-ATLaS) -- there is no hosted N-ATLaS API. Example: http://localhost:8080
NATLAS_ENDPOINT_URL=
# Optional -- only if your inference server requires an API key.
NATLAS_API_KEY=
