# Copy to .env and fill in for local development. Never commit .env.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://igboai:igboai@localhost:5432/igboai

# "mock" (default, Phase 2-4) or "natlas" (Phase 5+)
AI_PROVIDER=mock

# Only needed once AI_PROVIDER=natlas
NATLAS_ENDPOINT_URL=
NATLAS_API_KEY=
