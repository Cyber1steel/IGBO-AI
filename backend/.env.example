# Copy to .env and fill in for local development. Never commit .env.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://igboai:igboai@localhost:5432/igboai

# "mock" (default) | "general" | "natlas"
AI_PROVIDER=mock

# Only needed if AI_PROVIDER=general. A real, capable LLM (Google Gemini)
# used as a practical stand-in for N-ATLaS -- has a free tier, no credit
# card required. Get a key at https://aistudio.google.com/apikey
# (see backend/README.md "Using a real AI provider" for free-tier notes
# and how to swap to a different vendor if you prefer).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Only needed if AI_PROVIDER=natlas. Must be a self-hosted OpenAI-compatible
# chat-completions endpoint (e.g. vLLM's OpenAI-compatible server running
# N-ATLaS) -- there is no hosted N-ATLaS API. Example: http://localhost:8080
NATLAS_ENDPOINT_URL=
# Optional -- only if your inference server requires an API key.
NATLAS_API_KEY=
